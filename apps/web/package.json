{
	"name": "web",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc -b",
		"start": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000}",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"typecheck": "tsc -b",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@grafana/faro-web-sdk": "^2.12.1",
		"@grafana/faro-web-tracing": "^2.12.1",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/react": "^1.1.10",
		"@sentry/react": "^11.8.0",
		"@tanstack/react-query": "^5.104.3",
		"@tanstack/react-router": "^1.170.44",
		"@workspace/ui": "workspace:*",
		"better-auth": "^1.7.10",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"serve": "^14.2.6"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4",
		"@tanstack/router-plugin": "^1.168.46",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"jsdom": "^30.1.3",
		"typescript": "~6.0.2",
		"vite": "^8",
		"vitest": "^4.1.2"
	}
}
