{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
		"target": "es2023",
		"lib": ["ES2023", "DOM"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"skipLibCheck": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["server"]
}
