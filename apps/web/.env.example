# Keep it relative: the browser must reach the API on the web app's own origin
# (Vite's proxy in dev, server/index.ts when deployed) so Better Auth's session
# cookie stays first-party. An API on another site loses the cookie.
VITE_API_URL=/api

# Deployed only (server/index.ts, not Vite): where /api/* is proxied to, e.g.
# the API's private Railway address http://api.railway.internal:3000
API_INTERNAL_URL=

# Grafana Cloud Frontend Observability (Faro) — create a collector app at
# https://grafana.com/orgs/<org>/stacks/<stack>/frontend-observability
VITE_FARO_COLLECTOR_URL=

# Sentry — create a project at https://sentry.io to get a DSN
VITE_SENTRY_DSN=
