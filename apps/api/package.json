{
	"name": "api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"build": "nest build",
		"deploy": "nest deploy",
		"dev": "NODE_OPTIONS=--import=./dist/lib/tracing.js nest start --watch",
		"format": "biome format --write .",
		"start": "NODE_OPTIONS=--import=./dist/lib/tracing.js nest start",
		"start:dev": "NODE_OPTIONS=--import=./dist/lib/tracing.js nest start --watch",
		"start:debug": "NODE_OPTIONS=--import=./dist/lib/tracing.js nest start --debug --watch",
		"start:prod": "NODE_OPTIONS=--import=./dist/lib/tracing.js node dist/main",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun src/database/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"agents:types": "openapi-typescript ../agents/openapi.json -o src/agents/agents-api.gen.ts && biome format --write src/agents/agents-api.gen.ts"
	},
	"dependencies": {
		"@better-auth/i18n": "^1.7.10",
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.0.1",
		"@nestjs/platform-express": "^12.0.1",
		"@nestjs/swagger": "^12.0.2",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/api-logs": "^0.223.0",
		"@opentelemetry/auto-instrumentations-node": "^0.81.1",
		"@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
		"@opentelemetry/resources": "^2.12.0",
		"@opentelemetry/sdk-logs": "^0.223.0",
		"@opentelemetry/sdk-node": "^0.223.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"@workspace/i18n": "workspace:*",
		"better-auth": "^1.7.10",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dotenv": "^18.0.8",
		"drizzle-orm": "^0.45.4",
		"express": "^5.3.0",
		"ioredis": "^6.0.0",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.34.0",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.10",
		"@nestjs/cli": "^12.0.0",
		"@nestjs/mau": "^0.2.6",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.0.1",
		"@types/express": "^5.0.0",
		"@types/node": "^24.0.0",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.0.0",
		"@vitest/coverage-v8": "^4.1.2",
		"drizzle-kit": "^0.31.11",
		"openapi-typescript": "^7.13.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"typescript": "^6.0.2",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.2"
	}
}
