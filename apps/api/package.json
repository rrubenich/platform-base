{
	"name": "api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"build": "nest build",
		"deploy": "nest deploy",
		"dev": "NODE_OPTIONS=--import=dd-trace/initialize.mjs nest start --watch",
		"format": "biome format --write .",
		"start": "NODE_OPTIONS=--import=dd-trace/initialize.mjs nest start",
		"start:dev": "NODE_OPTIONS=--import=dd-trace/initialize.mjs nest start --watch",
		"start:debug": "NODE_OPTIONS=--import=dd-trace/initialize.mjs nest start --debug --watch",
		"start:prod": "NODE_OPTIONS=--import=dd-trace/initialize.mjs node dist/main",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun src/database/migrate.ts",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.0.1",
		"@nestjs/observe": "^0.1.8",
		"@nestjs/platform-express": "^12.0.1",
		"@nestjs/swagger": "^12.0.2",
		"dd-trace": "^6.21.0",
		"drizzle-orm": "^0.45.4",
		"ioredis": "^6.0.0",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.0",
		"@nestjs/mau": "^0.2.6",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.0.1",
		"@types/express": "^5.0.0",
		"@types/node": "^24.0.0",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.0.0",
		"@vitest/coverage-v8": "^4.1.2",
		"drizzle-kit": "^0.31.11",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"typescript": "^6.0.2",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.2"
	}
