PORT=3000

# Matches the docker-compose postgres service by default
DATABASE_URL=postgres://platform-base:platform-base@localhost:5432/platform-base

# Matches the docker-compose redis service by default
REDIS_URL=redis://localhost:6379

# Datadog APM — read by dd-trace/initialize.mjs, sent to the local agent from docker-compose
DD_SERVICE=api
DD_ENV=development
DD_VERSION=0.0.1
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126
