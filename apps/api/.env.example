PORT=3000

# Neon Postgres — run `neon env pull --file apps/api/.env -s postgres` from the
# repo root to fill this in (or copy it from the Neon console)
DATABASE_URL=

# Better Auth — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated user ids granted every admin permission regardless of their
# role — use it to bootstrap the first admin, then promote others via
# POST /api/auth/admin/set-role and remove the id from here
ADMIN_USER_IDS=
# apps/web's dev origin, added to Better Auth's trustedOrigins
WEB_URL=http://localhost:5173

# Google OAuth — create a client at https://console.cloud.google.com/apis/credentials
# with redirect URI {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple — create a Services ID at
# https://developer.apple.com/account/resources/identifiers/list/serviceId
# with return URL {BETTER_AUTH_URL}/api/auth/callback/apple (HTTPS only — Apple
# rejects localhost). APPLE_CLIENT_ID is the Services ID; APPLE_CLIENT_SECRET is
# a JWT signed with your Sign in with Apple key (.p8), valid for at most 6 months.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Microsoft — register an app at https://entra.microsoft.com (App registrations)
# with web redirect URI {BETTER_AUTH_URL}/api/auth/callback/microsoft.
# MICROSOFT_TENANT_ID defaults to "common" (work/school and personal accounts).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Resend — get an API key at https://resend.com/api-keys, used to send
# verification and magic-link emails (see src/lib/auth.ts)
RESEND_API_KEY=
EMAIL_FROM="Platform Base <onboarding@resend.dev>"

# Redis Cloud — get this from your database's "Connect" page at
# https://app.redislabs.com (or redis.io/try-free to create one)
REDIS_URL=redis://default:<password>@<host>.redis.io:<port>

# Internal agents service (apps/agents). AGENTS_SERVICE_TOKEN must match the
# one in apps/agents/.env — generate with `openssl rand -base64 32`
AGENTS_URL=http://localhost:8000
AGENTS_SERVICE_TOKEN=

# OpenTelemetry — read by dist/lib/tracing.js (see src/lib/tracing.ts)
OTEL_SERVICE_NAME=api
OTEL_SERVICE_VERSION=0.0.1

# Grafana Cloud OTLP gateway — from your stack's Connections > OpenTelemetry
# page ("View connection details"), which gives you these pre-filled
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceID:apiToken)>
