# Port the FastAPI server listens on (apps/api reaches it at AGENTS_URL)
AGENTS_PORT=8000

# Public half of apps/api's AGENTS_JWT_PRIVATE_KEY (see apps/api/.env.example
# for generating the pair), quoted with its line breaks. Verifies the token
# apps/api signs for each call; this service can't mint tokens with it.
AGENTS_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# Same Redis Cloud database as apps/api; background jobs use their own queue
REDIS_URL=redis://default:<password>@<host>.redis.io:<port>
# AGENTS_QUEUE_NAME=agents:queue
# AGENTS_JOB_RESULT_TTL=86400

# Neon *direct* (unpooled) connection string for chat threads, stored in
# their own `langgraph` schema. Create/migrate its tables with
# `bun run db:checkpoints`. Unset: threads are kept in memory and lost on
# restart, which is only acceptable for local dev.
# AGENTS_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# Chat model every agent runs on, as a LangChain "<provider>:<model>" id.
# To switch provider, change it and `uv add langchain-<provider>`, e.g.
# LLM_MODEL=anthropic:claude-opus-5-5 with langchain-anthropic and
# ANTHROPIC_API_KEY, or google_genai:<model> with langchain-google-genai.
LLM_MODEL=openai:gpt-5.5
# The provider's own key — https://platform.openai.com/api-keys for OpenAI
OPENAI_API_KEY=

# OpenTelemetry — read by `opentelemetry-instrument` (see package.json); same
# Grafana Cloud stack as apps/api so traces join across services
OTEL_SERVICE_NAME=agents
OTEL_SERVICE_VERSION=0.1.0
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceID:apiToken)>

# LangSmith: traces every agent run (agent, entrypoint, user, organization
# and thread as metadata; delegations nested), and records `bun run eval`
# runs as experiments. Read by the langsmith package; app code never imports
# it. https://smith.langchain.com/settings
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=platform-base-agents-dev
# EU region: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Traces include message content. Where it holds sensitive or personal data, hide it:
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# Integration tests only (`bun run test`): a disposable database, e.g. a
# Neon branch's direct URL. Tests work in a throwaway schema. Unset: skipped.
# AGENTS_TEST_DATABASE_URL=

# Docs assistant: the directory holding AGENTS.md, README.md and docs/.
# Defaults to the root of this repository checkout.
# DOCS_ROOT=/srv/platform-base
